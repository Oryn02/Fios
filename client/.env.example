# Vite client env — placeholders only. Copy to client/.env (gitignored).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ADMIN_UID=your-supabase-user-uuid
VITE_GITHUB_TOKEN=ghp_your_github_pat_with_gist_scope
VITE_DEMO_MODE=false
# Production (Render Static Site): origin of the Express Web Service — NO /api suffix
# Example: https://fios-api.onrender.com
# Leave empty for local Vite (proxies /api → localhost:5000)
VITE_API_URL=
