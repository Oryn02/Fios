# Copy to `.env`, `client/.env`, and/or `server/.env` — never commit real values.
# Client (Vite) reads VITE_* from `client/.env` (baked in at build time on Render).
# Server reads PORT + GEMINI_API_KEY (+ CLIENT_ORIGIN) from `server/.env` or Render env.

# --- Client (Vite / Render Static Site) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ADMIN_UID=your-supabase-user-uuid
VITE_GITHUB_TOKEN=ghp_your_github_pat_with_gist_scope
VITE_DEMO_MODE=false
# Render API origin only (no trailing slash, no /api). Empty = relative /api (local proxy).
VITE_API_URL=https://fios-api.onrender.com

# --- Server (Express / Render Web Service) ---
PORT=5000
GEMINI_API_KEY=your-gemini-api-key
# Comma-separated browser origins allowed to call the API (your Static Site URL)
CLIENT_ORIGIN=https://fios-web.onrender.com
