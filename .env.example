# Copy to `.env`, `client/.env`, and/or `server/.env` — never commit real values.
# Client (Vite) reads VITE_* from `client/.env`.
# Server reads PORT / keys from `server/.env` (or repo-root `.env`).

# --- Client (Vite) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ADMIN_UID=your-supabase-user-uuid
VITE_GITHUB_TOKEN=ghp_your_github_pat_with_gist_scope
VITE_SUPPORT_EMAIL=support@example.com
VITE_DEMO_MODE=false

# --- Server (Express) ---
PORT=5000
GEMINI_API_KEY=your-gemini-api-key
SUPPORT_EMAIL=support@example.com
SUPPORT_FROM_EMAIL=Fios Support Form <onboarding@resend.dev>
# Prefer one email provider:
RESEND_API_KEY=re_xxxxxxxx
# SENDGRID_API_KEY=SG.xxxxxxxx
