# Copy to `.env`, `client/.env`, and/or `server/.env` — never commit real values.
# Client (Vite) reads VITE_* from `client/.env` (baked in at build time on Render).
# Server reads PORT + GEMINI_API_KEY (+ CLIENT_ORIGIN) from `server/.env` or Render env.

# --- Client (Vite / Render Static Site) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ADMIN_UID=your-supabase-user-uuid
VITE_GITHUB_TOKEN=ghp_your_github_pat_with_gist_scope
VITE_DEMO_MODE=false
# Support inbox shown in Contact Support (optional; defaults to operator inbox in UI)
VITE_SUPPORT_EMAIL=oryn02@gmail.com
# Render API origin only (no trailing slash, no /api). Empty = relative /api (local proxy).
VITE_API_URL=https://fios-akjy.onrender.com

# --- Server (Express / Render Web Service) ---
PORT=5000
GEMINI_API_KEY=your-gemini-api-key
# Comma-separated browser origins allowed to call the API (your Static Site URL)
CLIENT_ORIGIN=https://fios-web.onrender.com
ADMIN_UID=your-supabase-user-uuid
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Support form email delivery (optional — clear 503 if unset)
SUPPORT_EMAIL=oryn02@gmail.com
SUPPORT_FROM_EMAIL=Fios Support Form <onboarding@resend.dev>
RESEND_API_KEY=
# SENDGRID_API_KEY=

# Web Push (class reminders) — generate with: npx web-push generate-vapid-keys
# Required on the Render Web Service for server-side push; client still uses
# local Notification API reminders when the app/PWA is open.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:oryn02@gmail.com

# --- Master SaaS (Phases 0–6; billing off) ---
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro
GEMINI_USE_CONTEXT_CACHE=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GOOGLE_TTS_API_KEY=
AUDIO_RECAP_MAX_SECONDS=300
FSRS_REQUEST_RETENTION=0.9
BILLING_PROVIDER=off
