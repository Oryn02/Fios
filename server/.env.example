# Express server env — placeholders only. Copy to server/.env (gitignored).
# On Render Web Service: set these in the dashboard (Root Directory = server).
PORT=5000
GEMINI_API_KEY=your-gemini-api-key
# Static site origin(s), comma-separated — required when client is a separate Render service
# Confirmed Static Site: https://fios-web.onrender.com (API is https://fios-akjy.onrender.com)
CLIENT_ORIGIN=https://fios-web.onrender.com
# Admin feedback API (GET /api/admin/feedback) — must match VITE_ADMIN_UID
ADMIN_UID=your-supabase-user-uuid
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Support form (POST /api/support) — optional; returns clear 503 if provider unset
SUPPORT_EMAIL=oryn02@gmail.com
SUPPORT_FROM_EMAIL=Fios Support Form <onboarding@resend.dev>
RESEND_API_KEY=
# SENDGRID_API_KEY=

# Web Push / VAPID (class reminders) — npx web-push generate-vapid-keys
# Without these, /api/push/* returns 503; the client still schedules local notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:oryn02@gmail.com
